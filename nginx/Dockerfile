# Берем официальный образ nginx на базе Alpine Linux (очень маленький)
FROM nginx:alpine

# Копируем наш конфигурационный файл внутрь контейнера
# nginx будет использовать его вместо удаленного дефолтного
COPY nginx.conf /etc/nginx/nginx.conf
# Проверяем, что наш конфиг правильный (нет синтаксических ошибок)

# Говорим Docker, что контейнер будет слушать порт 80
EXPOSE 80 443

# Запускаем nginx в foreground режиме (не как демон)
# daemon off; - важно для Docker, чтобы контейнер не завершился
CMD ["nginx", "-g", "daemon off;"]