FROM node:22-bullseye AS builder
WORKDIR /app

# Устанавливаем pnpm
RUN npm install -g pnpm@8.10.2

# Копируем ВЕСЬ код СНАЧАЛА
COPY . .

# Удаляем только lock-файл, но сохраняем package.json
RUN rm -f pnpm-lock.yaml

# Устанавливаем зависимости (теперь все файлы на месте)
RUN pnpm install --force

# Собираем проект
RUN pnpm run build

VOLUME ["/app/dist"]